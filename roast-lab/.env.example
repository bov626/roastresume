# Copy this file to `.env` and paste your key. `.env` is gitignored — never commit it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default model is the flagship claude-opus-4-8. Override here if it's not on
# your account (alternatives: claude-opus-4-5, claude-sonnet-4-6).
# ROAST_MODEL=claude-opus-4-8

# Optional: change the port (default 5055).
# PORT=5055

# ── Community gate (members-only scan) ──
# Set ROAST_COMMUNITY_GATE=1 to require a member access code before scanning.
# ROAST_COMMUNITY_GATE=1
# ROAST_COMMUNITY_CODES=your-secret-member-code,another-code
# ROAST_SKOOL_URL=https://www.skool.com/remote/about
# ROAST_COMMUNITY_SECRET=optional-signing-secret-for-access-tokens
